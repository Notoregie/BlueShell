<?xml version="1.0" encoding="utf-8" ?>
<XmlShell>
	<ShellCommand
		Id="cd"
		Type="default"
		Summary="Changes the current working directory.">
	</ShellCommand>
	<ShellCommand
		Id="help"
		Type="default"
		Summary="Lists all registered commands.">
	</ShellCommand>
	<ShellCommand
		Id="dir"
		Type="default"
		Summary="Lists top-level directories.">
	</ShellCommand>
	<ShellCommand
		Id="bios"
		Type="custom"
		Summary="Restart into bios">
	</ShellCommand>
	<ShellCommand
		Id="clear"
		Type="custom"
		Summary="Clears the console screen.">
	</ShellCommand>
	<ShellCommand
		Id="echo"
		Type="default"
		Summary="Writes the provided text to the console.">
	</ShellCommand>
	<ShellCommand
		Id="ping"
		Type="default"
		Summary="Sends a ping request to a hostname or IP address.">
	</ShellCommand>
	<ShellCommand
		Id="ipconfig"
		Type="custom"
		Summary="Shows your IP configuration">
	</ShellCommand>
	<ShellCommand
		Id="tree"
		Type="default"
		Summary="Displays the directory tree recursively.">
	</ShellCommand>
	
	
	<ShellCommand
		Id="note"
		Type="custom"
		Summary="Creates a .txt file with content on the desktop.">
	</ShellCommand>
	<ShellCommand
		Id="report"
		Type="custom"
		Summary="Send an Email with bug reports">
	</ShellCommand>
	<ShellCommand
		Id="mode"
		Type="custom"
		Summary="Switch app mode">
	</ShellCommand>
</XmlShell>
